{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dispatch.invalid/schemas/dispatch-browser-runtime-evidence-v1.schema.json",
  "title": "Dispatch browser runtime local installation evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generation",
    "verified_at",
    "platform",
    "os_dependencies",
    "sandbox",
    "launch_probe"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "generation": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "distribution", "distribution_version", "architecture"],
      "properties": {
        "system": {"const": "linux"},
        "distribution": {"const": "ubuntu"},
        "distribution_version": {"const": "24.04"},
        "architecture": {"const": "x86_64"}
      }
    },
    "os_dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified", "receipt_sha256"],
      "properties": {
        "verified": {"const": true},
        "receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified", "policy_id", "receipt_sha256"],
      "properties": {
        "verified": {"const": true},
        "policy_id": {"const": "dispatch-chromium-apparmor-v1"},
        "receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "launch_probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "executable_sha256", "receipt_sha256"],
      "properties": {
        "passed": {"const": true},
        "executable_sha256": {"$ref": "#/$defs/sha256"},
        "receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
