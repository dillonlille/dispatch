{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dispatch.example.invalid/schemas/dispatch-plugin-v1.schema.json",
  "title": "Dispatch Plugin Source Manifest v1",
  "description": "Optional descriptive metadata for a source-owned Dispatch plugin. It is not runtime, activation, release, or receipt authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "display_name",
    "version",
    "summary",
    "owner",
    "paths",
    "commands",
    "components"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"$ref": "#/$defs/slug"},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 80},
    "version": {"$ref": "#/$defs/version"},
    "summary": {"type": "string", "minLength": 10, "maxLength": 300},
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "team"],
      "properties": {
        "data": {"$ref": "#/$defs/slug"},
        "team": {"type": "string", "minLength": 1, "maxLength": 80}
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "tests"],
      "properties": {
        "source": {"$ref": "#/$defs/relativePath"},
        "tests": {"$ref": "#/$defs/relativePath"},
        "data": {"$ref": "#/$defs/relativePath"},
        "references": {"$ref": "#/$defs/relativePath"},
        "hermes_integration": {"$ref": "#/$defs/relativePath"}
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["test", "build", "verify", "health"],
      "properties": {
        "test": {"const": "./scripts/test"},
        "build": {"const": "./scripts/build"},
        "verify": {"const": "./scripts/verify"},
        "health": {"const": "./scripts/health"}
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/component"}
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read_local_data",
        "mutate_data",
        "collect",
        "network",
        "authentication",
        "direct_delivery",
        "long_running"
      ],
      "properties": {
        "read_local_data": {"type": "boolean"},
        "mutate_data": {"type": "boolean"},
        "collect": {"type": "boolean"},
        "network": {"type": "boolean"},
        "authentication": {"type": "boolean"},
        "direct_delivery": {"type": "boolean"},
        "long_running": {"type": "boolean"}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "privilege"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 64},
        "privilege": {"enum": ["read", "health", "mutation", "administration", "direct-delivery"]}
      }
    },
    "hermes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "manifest", "adapter", "tool", "toolset"],
      "properties": {
        "package": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "manifest": {"$ref": "#/$defs/relativePath"},
        "adapter": {"$ref": "#/$defs/relativePath"},
        "tool": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "toolset": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "source", "capabilities"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "kind": {
          "enum": [
            "hermes-tool",
            "collector",
            "service",
            "auth-provider",
            "library",
            "control-plane",
            "retired"
          ]
        },
        "source": {"$ref": "#/$defs/relativePath"},
        "capabilities": {"$ref": "#/$defs/capabilities"},
        "hermes": {"$ref": "#/$defs/hermes"},
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/action"}
        },
        "coordinator_mode": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "service_units": {
          "type": "array",
          "items": {"$ref": "#/$defs/relativePath"},
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"kind": {"const": "hermes-tool"}},
            "required": ["kind"]
          },
          "then": {"required": ["hermes", "actions"]}
        }
      ]
    }
  }
}
