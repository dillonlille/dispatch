{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dispatch.invalid/schemas/dispatch-browser-runtime-generation-v1.schema.json",
  "title": "Dispatch browser runtime generation manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generation",
    "installer_release",
    "platform",
    "playwright",
    "browser",
    "sandbox",
    "files"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "generation": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "installer_release": {
      "type": "string",
      "pattern": "^dispatch-installer-[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "distribution", "distribution_version", "architecture"],
      "properties": {
        "system": {"const": "linux"},
        "distribution": {"const": "ubuntu"},
        "distribution_version": {"const": "24.04"},
        "architecture": {"const": "x86_64"}
      }
    },
    "playwright": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "module_relative_path",
        "driver_executable_relative_path",
        "driver_cli_relative_path"
      ],
      "properties": {
        "version": {"const": "1.62.0"},
        "module_relative_path": {"$ref": "#/$defs/relativePath"},
        "driver_executable_relative_path": {"$ref": "#/$defs/relativePath"},
        "driver_cli_relative_path": {"$ref": "#/$defs/relativePath"}
      }
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "version", "playwright_revision", "executable_relative_path"],
      "properties": {
        "family": {"const": "chromium"},
        "version": {"const": "151.0.7922.34"},
        "playwright_revision": {"const": "1234"},
        "executable_relative_path": {"$ref": "#/$defs/relativePath"}
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id"],
      "properties": {
        "policy_id": {"const": "dispatch-chromium-apparmor-v1"}
      }
    },

    "files": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 100000,
      "propertyNames": {"$ref": "#/$defs/relativePath"},
      "additionalProperties": {"$ref": "#/$defs/member"}
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*[\\u0000-\\u001f])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^/]+(?:/[^/]+)*$",
      "not": {"enum": ["tree-manifest.json", "installation-receipt.json", "installation-evidence.json"]}
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size", "sha256", "executable"],
      "properties": {
        "size": {"type": "integer", "minimum": 0, "maximum": 1073741824},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "executable": {"type": "boolean"}
      }
    }
  }
}
