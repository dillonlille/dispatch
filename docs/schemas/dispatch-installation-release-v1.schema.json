{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dispatch.invalid/schemas/dispatch-installation-release-v1.schema.json",
  "title": "Dispatch product release manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ready",
    "product",
    "installer",
    "core",
    "builtin_plugins",
    "browser_runtime",
    "post_install",
    "uninstall"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "ready": {"type": "boolean"},
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "dispatch"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "installer": {"$ref": "#/$defs/installer"},
    "core": {"$ref": "#/$defs/core"},
    "builtin_plugins": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "#/$defs/builtinPlugin"}
    },
    "browser_runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ready", "install_phase", "selector", "generation_root"],
      "properties": {
        "ready": {"type": "boolean"},
        "install_phase": {"const": "setup"},
        "selector": {"const": "/etc/dispatch/browser-runtime-active.json"},
        "generation_root": {"const": "/opt/dispatch/browser-runtimes"}
      }
    },
    "post_install": {
      "type": "object",
      "additionalProperties": false,
      "required": ["setup_implemented", "setup_command", "choices"],
      "properties": {
        "setup_implemented": {"type": "boolean"},
        "setup_command": {"const": "dispatch setup"},
        "choices": {"const": ["start_setup", "skip_for_now"]}
      }
    },
    "uninstall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_scope_implemented",
        "administrative_command",
        "future_user_command",
        "default_mode",
        "purge_requires_confirmation",
        "privileged_browser_removal_implemented"
      ],
      "properties": {
        "user_scope_implemented": {"const": true},
        "administrative_command": {"const": "dispatch-installer uninstall"},
        "future_user_command": {"const": "dispatch uninstall"},
        "default_mode": {"const": "keep-data"},
        "purge_requires_confirmation": {"const": true},
        "privileged_browser_removal_implemented": {"const": false}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"ready": {"const": true}}, "required": ["ready"]},
      "then": {
        "properties": {
          "installer": {"properties": {"artifact": {"$ref": "#/$defs/completeArtifact"}}},
          "core": {"properties": {"artifact": {"$ref": "#/$defs/completeArtifact"}}},
          "builtin_plugins": {
            "items": {"properties": {"artifact": {"$ref": "#/$defs/completeArtifact"}}}
          },
          "post_install": {
            "properties": {"setup_implemented": {"const": true}}
          }
        }
      },
      "else": {
        "properties": {
          "installer": {"properties": {"artifact": {"$ref": "#/$defs/nullArtifact"}}},
          "core": {"properties": {"artifact": {"$ref": "#/$defs/nullArtifact"}}},
          "builtin_plugins": {
            "items": {"properties": {"artifact": {"$ref": "#/$defs/nullArtifact"}}}
          },
          "browser_runtime": {"properties": {"ready": {"const": false}}}
        }
      }
    }
  ],
  "$defs": {
    "artifact": {
      "oneOf": [
        {"$ref": "#/$defs/nullArtifact"},
        {"$ref": "#/$defs/completeArtifact"}
      ]
    },
    "nullArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "size", "sha256"],
      "properties": {
        "url": {"const": null},
        "size": {"const": null},
        "sha256": {"const": null}
      }
    },
    "completeArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "size", "sha256"],
      "properties": {
        "url": {"type": "string", "pattern": "^https://"},
        "size": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "installer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "artifact"],
      "properties": {
        "name": {"const": "dispatch-installer"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "artifact": {"$ref": "#/$defs/artifact"}
      }
    },
    "core": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "artifact", "package_files", "requires_dist"],
      "properties": {
        "name": {"const": "dispatch-core"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "artifact": {"$ref": "#/$defs/artifact"},
        "package_files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {"$ref": "#/$defs/packageFile"}
        },
        "requires_dist": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        }
      }
    },
    "packageFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^dispatch_core/"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "builtinPlugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "package", "version", "artifact", "capabilities", "requires_dist"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
        "package": {"type": "string", "pattern": "^dispatch-[a-z0-9][a-z0-9-]{0,63}$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "artifact": {"$ref": "#/$defs/artifact"},
        "capabilities": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}
        },
        "requires_dist": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        }
      }
    }
  }
}
