#!/usr/bin/env python3
"""Finalize the immutable Core-only Dispatch 0.0.1 release directory."""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "installer" / "src"))

from dispatch_installer.manifest import load_manifest  # noqa: E402


def _sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def _copy_file(source: Path, destination: Path, mode: int) -> None:
    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{destination.name}.", dir=destination.parent)
    temporary = Path(temporary_name)
    try:
        os.fchmod(descriptor, mode)
        with source.open("rb") as reader, os.fdopen(descriptor, "wb") as writer:
            descriptor = -1
            shutil.copyfileobj(reader, writer, length=1024 * 1024)
            writer.flush()
            os.fsync(writer.fileno())
        os.replace(temporary, destination)
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        temporary.unlink(missing_ok=True)


def _write(path: Path, content: bytes, mode: int) -> None:
    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary = Path(temporary_name)
    try:
        os.fchmod(descriptor, mode)
        with os.fdopen(descriptor, "wb") as stream:
            descriptor = -1
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        temporary.unlink(missing_ok=True)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--installer-wheel", type=Path, required=True)
    parser.add_argument("--core-wheel", type=Path, required=True)
    parser.add_argument("--output-dir", type=Path, required=True)
    parser.add_argument(
        "--acceptance-candidate",
        action="store_true",
        help="allow a staged candidate while production_install_ready remains false",
    )
    parser.add_argument(
        "--manifest",
        type=Path,
        default=ROOT / "packaging" / "installation-release-manifest.json",
    )
    args = parser.parse_args()

    approval = json.loads((ROOT / "packaging" / "installer-package-plan.json").read_text(encoding="utf-8"))[
        "production_install_ready"
    ]
    if not approval and not args.acceptance_candidate:
        raise SystemExit("production installation has not passed acceptance")
    if args.output_dir.exists() and any(args.output_dir.iterdir()):
        raise SystemExit("release output directory must be absent or empty")
    args.output_dir.mkdir(parents=True, mode=0o755, exist_ok=True)

    subprocess.run(
        [sys.executable, str(ROOT / "scripts" / "verify-installer-wheel"), str(args.installer_wheel), "--json"],
        check=True,
    )
    subprocess.run(
        [sys.executable, str(ROOT / "scripts" / "verify-core-wheel"), str(args.core_wheel), "--json"],
        check=True,
    )

    payload = json.loads(args.manifest.read_text(encoding="utf-8"))
    if payload.get("ready") is not False or payload.get("builtin_plugins") != []:
        raise SystemExit("release source manifest must be a Core-only draft")
    version = payload["product"]["version"]
    expected_names = {
        "installer": f"dispatch_installer-{payload['installer']['version']}-py3-none-any.whl",
        "core": f"dispatch_core-{payload['core']['version']}-py3-none-any.whl",
    }
    if args.installer_wheel.name != expected_names["installer"] or args.core_wheel.name != expected_names["core"]:
        raise SystemExit("release wheel filename differs from the manifest")

    for component, source in (("installer", args.installer_wheel), ("core", args.core_wheel)):
        payload[component]["artifact"] = {
            "url": f"https://dispatch.dillonlille.com/releases/{version}/{source.name}",
            "size": source.stat().st_size,
            "sha256": _sha256(source),
        }
    payload["ready"] = True
    manifest_content = (json.dumps(payload, indent=2, sort_keys=True) + "\n").encode("utf-8")
    manifest_path = args.output_dir / "installation-release-manifest.json"
    _write(manifest_path, manifest_content, 0o644)
    manifest_sha256 = _sha256(manifest_path)
    load_manifest(manifest_path, expected_sha256=manifest_sha256)

    for source in (args.installer_wheel, args.core_wheel):
        _copy_file(source, args.output_dir / source.name, 0o644)
    source_commit = subprocess.run(
        ["git", "rev-parse", "HEAD"],
        cwd=ROOT,
        check=True,
        capture_output=True,
        text=True,
    ).stdout.strip()
    artifacts = [manifest_path, args.output_dir / args.installer_wheel.name, args.output_dir / args.core_wheel.name]
    checksums = "".join(f"{_sha256(path)}  {path.name}\n" for path in artifacts).encode("utf-8")
    _write(args.output_dir / "SHA256SUMS", checksums, 0o644)
    evidence = {
        "schema_version": 1,
        "product_version": version,
        "source_commit": source_commit,
        "manifest_sha256": manifest_sha256,
        "production_approved": bool(approval),
        "artifacts": [
            {"name": path.name, "size": path.stat().st_size, "sha256": _sha256(path)} for path in artifacts
        ],
        "contains_secrets": False,
    }
    _write(
        args.output_dir / "release-evidence.json",
        (json.dumps(evidence, indent=2, sort_keys=True) + "\n").encode("utf-8"),
        0o644,
    )
    directory = os.open(args.output_dir, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
    try:
        os.fsync(directory)
    finally:
        os.close(directory)
    print(json.dumps(evidence, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
