#!/usr/bin/env python3
"""Stage and verify a built Core wheel against the reviewed runtime policy."""

from __future__ import annotations

import argparse
import hashlib
import json
import stat
from pathlib import Path

from dispatch_installer import InstallLayout, stage_core_wheel, verify_core_release

ROOT = Path(__file__).resolve().parents[1]
PLAN = ROOT / "packaging" / "runtime-package-plan.json"


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("wheel", type=Path)
    parser.add_argument("--work-root", required=True, type=Path)
    arguments = parser.parse_args()

    wheel = arguments.wheel.resolve(strict=True)
    work_root = arguments.work_root.resolve()
    if work_root.exists() or work_root.is_symlink():
        raise SystemExit("work root must not already exist")
    work_root.mkdir(parents=True, mode=0o700)
    if stat.S_IMODE(work_root.stat().st_mode) != 0o700:
        raise SystemExit("work root is not private")

    plan = json.loads(PLAN.read_text(encoding="utf-8"))
    distributions = plan.get("distributions")
    if not isinstance(distributions, list) or len(distributions) != 1:
        raise SystemExit("runtime plan must declare exactly one Core distribution")
    distribution = distributions[0]
    package_policy = {
        entry["path"]: entry["sha256"]
        for entry in distribution["files"]
    }
    dependency_policy = {
        *distribution["requires_dist"],
        *distribution["optional_requires_dist"],
    }

    environment = {
        "HOME": str(work_root / "home"),
        "XDG_RUNTIME_DIR": str(work_root / "run"),
    }
    layout = InstallLayout.from_environment(environment)
    layout.home.mkdir(parents=True, mode=0o700)
    layout.runtime.parent.mkdir(parents=True, mode=0o700)

    staged = stage_core_wheel(
        layout,
        wheel,
        expected_sha256=sha256_file(wheel),
        expected_version=distribution["version"],
        expected_package_files=package_policy,
        expected_requires_dist=dependency_policy,
    )
    release = layout.releases / str(staged["release_id"])
    verified = verify_core_release(release)
    print(
        json.dumps(
            {
                "status": "verified_staged_core_only",
                "release_id": verified["release_id"],
                "version": verified["version"],
            },
            sort_keys=True,
        )
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
