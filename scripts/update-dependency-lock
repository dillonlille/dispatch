#!/usr/bin/env python3
"""Regenerate the hash-pinned Core runtime lockfile.

Usage: scripts/update-dependency-lock

Resolves dispatch-core/requirements.txt for the full supported Python range
(3.11-3.13), refuses to write a lock whose pinned versions differ across that
range, and rewrites dispatch-core/requirements.lock with provenance comments.
"""
from __future__ import annotations

import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
REQUIREMENTS = ROOT / "dispatch-core" / "requirements.txt"
LOCK = ROOT / "dispatch-core" / "requirements.lock"
SUPPORTED = ("3.11", "3.12", "3.13")
HEADER = """\
# Hash-pinned Core runtime closure.
#
# Generated from requirements.txt by `scripts/update-dependency-lock`; do not
# edit by hand. Pins are identical across the supported Python range (3.11 -
# 3.13) and cover every wheel published for those versions, so installation is
# reproducible and byte-verified on any of them. The lock pins reviewed
# artifacts; it is not a wheel catalog - binaries still come from PyPI and are
# verified against these hashes at install time.
#
# Regenerate after any requirements.txt change:
#   uv pip compile dispatch-core/requirements.txt --only-binary :all: \
--generate-hashes --universal -o dispatch-core/requirements.lock
"""


def main() -> int:
    if subprocess.run(("sh", "-c", "command -v uv"), capture_output=True).returncode != 0:
        print("uv is required: https://docs.astral.sh/uv/", file=sys.stderr)
        return 2
    versions: dict[str, list[str]] = {}
    payloads: list[str] = []
    for python_version in SUPPORTED:
        command = [
            "uv", "pip", "compile",
            str(REQUIREMENTS),
            "--only-binary", ":all:",
            "--generate-hashes",
            "--python-version", python_version,
            "-o", "-",
            "--no-header",
        ]
        completed = subprocess.run(command, capture_output=True, text=True)
        if completed.returncode != 0:
            print(f"resolution failed for Python {python_version}:", file=sys.stderr)
            print(completed.stderr.strip(), file=sys.stderr)
            return 1
        payload = "\n".join(
            line
            for line in completed.stdout.splitlines()
            if not line.startswith("# This file was autogenerated")
            and not line.startswith("#    uv pip compile")
        )
        resolved = sorted(
            line.split("==")[0]
            for line in payload.splitlines()
            if line and not line.startswith(("#", "--hash", "    "))
        )
        versions[python_version] = resolved
        payloads.append(payload)

    reference = versions[SUPPORTED[0]]
    for python_version, resolved in versions.items():
        if resolved != reference:
            print(
                f"refusing to write lock: Python {python_version} resolves to a "
                f"different dependency set than {SUPPORTED[0]}",
                file=sys.stderr,
            )
            print(f"  {SUPPORTED[0]}: {reference}", file=sys.stderr)
            print(f"  {python_version}: {resolved}", file=sys.stderr)
            return 1

    body = "\n".join(payloads[-1].splitlines()).rstrip() + "\n"
    LOCK.write_text(HEADER + "\n" + body, encoding="utf-8")
    LOCK.chmod(0o644)
    print(f"wrote {LOCK.relative_to(ROOT)} ({len(reference)} packages)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
