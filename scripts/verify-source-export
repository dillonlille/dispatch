#!/usr/bin/env python3
"""Fail-closed verifier for a prospective public Dispatch source tree."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import stat
import sys
from pathlib import Path

MAX_FILE_SIZE = 2 * 1024 * 1024
SYNTHETIC_MANIFEST = "synthetic-data.json"


FORBIDDEN_DIR_NAMES = {
    ".mypy_cache",
    ".pytest_cache",
    ".ruff_cache",
    ".venv",
    "SKILLS",
    "__pycache__",
    "archive",
    "artifacts",
    "backup",
    "backups",
    "browser-state",
    "cache",
    "chrome-profile",
    "db",
    "dependencies",
    "downloads",
    "locks",
    "logs",
    "node_modules",
    "private",
    "receipts",
    "releases",
    "runtime",
    "safety-data",
    "staging",
    "state",
    "venv",
}
FORBIDDEN_FILE_SUFFIXES = {
    ".db",
    ".log",
    ".pyo",
    ".pyc",
    ".sqlite",
    ".sqlite3",
}
FORBIDDEN_EXACT_NAMES = {
    "Cookies",
    "History",
    "Login Data",
    "Web Data",
    "install-receipt.json",
    "launcher-manifest.json",
    "release-retention.json",
}
FORBIDDEN_NAME_PATTERNS = (
    re.compile(r"(?:^|[-_.])(?:wal|shm)$", re.IGNORECASE),
    re.compile(r"(?:active|rollback)[-_]?(?:release|selector|authority)", re.IGNORECASE),
    re.compile(r"(?:activation|deployment)[-_]?receipt", re.IGNORECASE),
    re.compile(r"\.pre-layout-v\d+$", re.IGNORECASE),
    re.compile(r"^\.hermes-tmp\.", re.IGNORECASE),
)
BINARY_OR_BUSINESS_SUFFIXES = {
    ".doc",
    ".docx",
    ".pdf",
    ".xls",
    ".xlsx",
}
DATA_SUFFIXES_REQUIRING_DECLARATION = {".csv", ".tsv"}
FIXTURE_DIR_NAMES = {"benchmarks", "demo-data", "examples", "fixtures", "samples"}
TEXT_SUFFIXES = {
    "",
    ".bash",
    ".cfg",
    ".conf",
    ".cjs",
    ".css",
    ".env",
    ".html",
    ".ini",
    ".js",
    ".json",
    ".jsx",
    ".md",
    ".mjs",
    ".py",
    ".rst",
    ".service",
    ".sh",
    ".sql",
    ".svg",
    ".timer",
    ".toml",
    ".ts",
    ".tsx",
    ".txt",
    ".xml",
    ".yaml",
    ".yml",
}
SECRET_PATTERNS = {
    "private key": re.compile(r"-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----"),
    "Slack token": re.compile(r"\bxox[baprs]-[A-Za-z0-9-]{10,}\b"),
    "GitHub token": re.compile(r"\bgh[pousr]_[A-Za-z0-9]{20,}\b"),
    "AWS access key": re.compile(r"\b(?:AKIA|ASIA)[A-Z0-9]{16}\b"),
    "Google API key": re.compile(r"\bAIza[0-9A-Za-z_-]{30,}\b"),
    "literal bearer credential": re.compile(
        r"(?i)\bBearer\s+[A-Za-z0-9._~+/-]{16,}={0,2}"
    ),
}
PERSONAL_PATH_PATTERNS = {
    "Unix personal home": re.compile(r"(?<![A-Za-z0-9_])/(?:home|Users)/[A-Za-z0-9._-]+(?:/|\b)"),
    "Windows personal home": re.compile(r"(?i)\b[A-Z]:\\Users\\[^\\\s]+"),
}
NON_PUBLIC_IDENTITY_PATTERNS = {
    "non-example email": re.compile(
        r"\b[A-Za-z0-9._%+-]+@(?!example\.(?:com|org|net)|example\.invalid)[A-Za-z0-9.-]+\.[A-Za-z]{2,}\b"
    ),
    "Slack object ID": re.compile(r"\b[CUWG](?=[A-Z0-9]{8,}\b)(?=[A-Z0-9]*\d)[A-Z0-9]{8,}\b"),
    "private hostname": re.compile(
        r"(?i)\b[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*\.(?:corp|internal|lan|local)\b"
    ),
    "private IPv4 address": re.compile(
        r"\b(?:10(?:\.\d{1,3}){3}|192\.168(?:\.\d{1,3}){2}|172\.(?:1[6-9]|2\d|3[01])(?:\.\d{1,3}){2})\b"
    ),
}
SECRET_KEY_LINE = re.compile(
    r"(?i)^\s*[\"']?(?:api[_-]?key|access[_-]?token|auth[_-]?token|bot[_-]?token|client[_-]?secret|cookie|password|private[_-]?key|secret|session)[\"']?\s*[:=]\s*(.*?)\s*[,#]?$"
)
PLACEHOLDER_VALUE = re.compile(
    r"(?i)^(?:$|null|none|false|0|<[^>]+>|\$\{[A-Z0-9_]+(?::-[^}]*)?\}|change(?:me|_me)|replace(?:me|_me)|your[_-].*|example(?:[_-].*)?)$"
)
IDENTITY_KEY_LINE = re.compile(
    r"(?i)^\s*[\"']?(?:account[_-]?id|channel[_-]?id|host(?:name)?|user[_-]?id|vault[_-]?(?:id|item)|workspace[_-]?id)[\"']?\s*[:=]\s*(.*?)\s*[,#]?$"
)
SAFE_PUBLIC_IDENTITY_VALUE = re.compile(r"(?i)^(?:localhost|example\.(?:com|org|net|invalid))$")


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def load_synthetic_manifest(root: Path, errors: list[str]) -> dict[str, dict]:
    path = root / SYNTHETIC_MANIFEST
    if not path.exists():
        return {}
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        errors.append(f"{SYNTHETIC_MANIFEST}: invalid JSON: {exc}")
        return {}
    if payload.get("schema_version") != 1 or not isinstance(payload.get("files"), dict):
        errors.append(
            f"{SYNTHETIC_MANIFEST}: requires schema_version=1 and an object named files"
        )
        return {}
    return payload["files"]


def is_fixture(path: Path) -> bool:
    return bool(set(path.parts) & FIXTURE_DIR_NAMES) or path.suffix.lower() in DATA_SUFFIXES_REQUIRING_DECLARATION


def validate_synthetic_declaration(
    relative: Path,
    path: Path,
    declarations: dict[str, dict],
    errors: list[str],
) -> bool:
    key = relative.as_posix()
    entry = declarations.get(key)
    if not isinstance(entry, dict):
        errors.append(f"{key}: fixture/data file lacks an explicit synthetic-data declaration")
        return False
    if entry.get("synthetic") is not True:
        errors.append(f"{key}: synthetic-data declaration must set synthetic=true")
        return False
    if entry.get("provenance") != "created-for-public-tests":
        errors.append(
            f"{key}: synthetic-data declaration provenance must be created-for-public-tests"
        )
        return False
    expected = entry.get("sha256")
    actual = sha256(path)
    if expected != actual:
        errors.append(f"{key}: synthetic-data declaration digest does not match file bytes")
        return False
    return True


def validate_example_secret_lines(relative: Path, text: str, errors: list[str]) -> None:
    for line_number, line in enumerate(text.splitlines(), start=1):
        match = SECRET_KEY_LINE.match(line)
        if not match:
            continue
        value = match.group(1).strip().strip("\"'")
        if not PLACEHOLDER_VALUE.match(value):
            errors.append(
                f"{relative.as_posix()}:{line_number}: secret-like setting has a non-placeholder value"
            )


def validate_identity_lines(relative: Path, text: str, errors: list[str]) -> None:
    for line_number, line in enumerate(text.splitlines(), start=1):
        match = IDENTITY_KEY_LINE.match(line)
        if not match:
            continue
        value = match.group(1).strip().strip("\"'")
        if not PLACEHOLDER_VALUE.match(value) and not SAFE_PUBLIC_IDENTITY_VALUE.match(value):
            errors.append(
                f"{relative.as_posix()}:{line_number}: identity-like setting has a non-placeholder value"
            )


def scan_text(
    relative: Path,
    path: Path,
    declared_synthetic: bool,
    errors: list[str],
) -> None:
    try:
        data = path.read_bytes()
    except OSError as exc:
        errors.append(f"{relative.as_posix()}: cannot read: {exc}")
        return
    if b"\x00" in data[:8192]:
        return
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError:
        errors.append(f"{relative.as_posix()}: text-like file is not valid UTF-8")
        return
    for label, pattern in SECRET_PATTERNS.items():
        if pattern.search(text):
            errors.append(f"{relative.as_posix()}: contains {label} marker")
    for label, pattern in PERSONAL_PATH_PATTERNS.items():
        if pattern.search(text):
            errors.append(f"{relative.as_posix()}: contains {label}")
    if not declared_synthetic:
        for label, pattern in NON_PUBLIC_IDENTITY_PATTERNS.items():
            if pattern.search(text):
                errors.append(f"{relative.as_posix()}: contains {label} outside declared synthetic data")
    validate_identity_lines(relative, text, errors)
    if "example" in relative.name.lower() or relative.name.lower().startswith(".env.example"):
        validate_example_secret_lines(relative, text, errors)


def verify(root: Path, max_file_size: int = MAX_FILE_SIZE) -> dict:
    root = root.resolve()
    errors: list[str] = []
    warnings: list[str] = []
    files_checked = 0
    symlinks_checked = 0
    declarations = load_synthetic_manifest(root, errors)
    declared_seen: set[str] = set()


    if not root.is_dir():
        return {"ok": False, "root": str(root), "errors": ["root is not a directory"]}

    for directory, dirnames, filenames in os.walk(root, followlinks=False):
        current = Path(directory)
        dirnames[:] = [name for name in dirnames if name != ".git"]

        for name in list(dirnames):
            path = current / name
            relative = path.relative_to(root)
            if path.is_symlink():
                symlinks_checked += 1
                target = os.readlink(path)
                resolved = (path.parent / target).resolve(strict=False)
                if os.path.isabs(target):
                    errors.append(f"{relative.as_posix()}: absolute symlink is forbidden")
                if not resolved.is_relative_to(root):
                    errors.append(f"{relative.as_posix()}: escaping symlink is forbidden")
                if not resolved.exists():
                    errors.append(f"{relative.as_posix()}: broken symlink is forbidden")
                dirnames.remove(name)
                continue
            if name in FORBIDDEN_DIR_NAMES:
                errors.append(f"{relative.as_posix()}/: forbidden directory category")
                dirnames.remove(name)

        for name in filenames:
            path = current / name
            relative = path.relative_to(root)
            key = relative.as_posix()
            if path.is_symlink():
                symlinks_checked += 1
                target = os.readlink(path)
                resolved = (path.parent / target).resolve(strict=False)
                if os.path.isabs(target):
                    errors.append(f"{key}: absolute symlink is forbidden")
                if not resolved.is_relative_to(root):
                    errors.append(f"{key}: escaping symlink is forbidden")
                if not resolved.exists():
                    errors.append(f"{key}: broken symlink is forbidden")
                continue

            files_checked += 1
            lower_name = name.lower()
            suffix = path.suffix.lower()
            try:
                size = path.stat().st_size
            except OSError as exc:
                errors.append(f"{key}: cannot stat: {exc}")
                continue
            if size > max_file_size:
                errors.append(f"{key}: exceeds maximum approved size of {max_file_size} bytes")
            if suffix in FORBIDDEN_FILE_SUFFIXES or name in FORBIDDEN_EXACT_NAMES:
                errors.append(f"{key}: forbidden file category")
            if any(pattern.search(name) for pattern in FORBIDDEN_NAME_PATTERNS):
                errors.append(f"{key}: generated deployment/temporary authority is forbidden")
            if suffix in BINARY_OR_BUSINESS_SUFFIXES:
                errors.append(f"{key}: office/PDF artifact is forbidden in public source")
            if (lower_name.startswith(".env") or lower_name.endswith(".env")) and "example" not in lower_name:
                errors.append(f"{key}: non-example environment file is forbidden")

            declared_synthetic = False
            if is_fixture(relative):
                declared_synthetic = validate_synthetic_declaration(
                    relative, path, declarations, errors
                )
                if declared_synthetic:
                    declared_seen.add(key)

            if (
                suffix in TEXT_SUFFIXES
                or name in {"README", "LICENSE"}
                or "example" in lower_name
            ):
                scan_text(relative, path, declared_synthetic, errors)

    for key in declarations:
        if key not in declared_seen:
            errors.append(f"{SYNTHETIC_MANIFEST}: declaration is stale or points outside fixture/data scope: {key}")

    if not (root / "README.md").is_file():
        warnings.append("README.md is missing")
    if not (root / "LICENSE").is_file():
        warnings.append("LICENSE is missing; publication remains blocked pending rights review")

    return {
        "ok": not errors,
        "root": str(root),
        "files_checked": files_checked,
        "symlinks_checked": symlinks_checked,
        "synthetic_declarations_checked": len(declared_seen),
        "errors": sorted(set(errors)),
        "warnings": sorted(set(warnings)),
    }


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("root", nargs="?", type=Path)
    parser.add_argument("--max-file-size", type=int, default=MAX_FILE_SIZE)
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args(argv)
    root = args.root or Path(__file__).resolve().parents[1]
    result = verify(root, args.max_file_size)
    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
    elif result["ok"]:
        print(
            f"PASS: {result['files_checked']} files, "
            f"{result['symlinks_checked']} symlinks, "
            f"{result['synthetic_declarations_checked']} synthetic declarations"
        )
        for warning in result["warnings"]:
            print(f"WARNING: {warning}")
    else:
        print("FAIL: prospective public source is not safe", file=sys.stderr)
        for error in result["errors"]:
            print(f"ERROR: {error}", file=sys.stderr)
        for warning in result["warnings"]:
            print(f"WARNING: {warning}", file=sys.stderr)
    return 0 if result["ok"] else 1


if __name__ == "__main__":
    raise SystemExit(main())
