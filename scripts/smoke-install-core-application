#!/usr/bin/env python3
from __future__ import annotations

import argparse
import hashlib
import json
import os
import stat
import subprocess
import sys
from pathlib import Path

from dispatch_installer.application import install_core_application
from dispatch_installer.layout import InstallLayout


def main() -> int:
    parser = argparse.ArgumentParser(description="Install and launch an actual Core wheel in an isolated user layout")
    parser.add_argument("core_wheel", type=Path)
    parser.add_argument("--runtime-plan", type=Path, required=True)
    parser.add_argument("--work-root", type=Path, required=True)
    args = parser.parse_args()

    wheel = args.core_wheel.resolve(strict=True)
    plan = json.loads(args.runtime_plan.resolve(strict=True).read_text(encoding="utf-8"))
    core = next(item for item in plan["distributions"] if item["name"] == "dispatch-core")
    home = args.work_root.resolve() / "home"
    runtime = args.work_root.resolve() / "run"
    home.mkdir(parents=True, mode=0o700, exist_ok=True)
    runtime.mkdir(parents=True, mode=0o700, exist_ok=True)
    home.chmod(0o700)
    runtime.chmod(0o700)
    os.environ["HOME"] = str(home)
    os.environ["XDG_RUNTIME_DIR"] = str(runtime)

    python = Path(sys.executable).absolute()
    try:
        python.relative_to(home / ".dispatch")
    except ValueError:
        print("installer Python must run from WORK_ROOT/home/.dispatch", file=sys.stderr)
        return 2

    installed = install_core_application(
        InstallLayout.from_environment(),
        wheel,
        expected_sha256=hashlib.sha256(wheel.read_bytes()).hexdigest(),
        expected_version=core["version"],
        expected_package_files={item["path"]: item["sha256"] for item in core["files"]},
        expected_requires_dist=[*core["requires_dist"], *core["optional_requires_dist"]],
        launcher_python=python,
    )
    launcher = Path(str(installed["launcher"]))
    completed = subprocess.run(
        [str(launcher), "--json", "health"],
        check=False,
        capture_output=True,
        text=True,
        env=os.environ.copy(),
    )
    payload = json.loads(completed.stdout)
    if completed.returncode != 0 or payload.get("ok") is not True or payload.get("status") != "setup_incomplete":
        print(completed.stdout + completed.stderr, file=sys.stderr)
        return 1
    if stat.S_IMODE(launcher.stat().st_mode) != 0o700:
        print("launcher mode differs", file=sys.stderr)
        return 1
    print(json.dumps({"status": "installed", "launcher": str(launcher), "health": payload["status"]}, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
