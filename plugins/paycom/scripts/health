#!/usr/bin/env sh
set -eu
ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
CODE_ROOT=${DISPATCH_CODE_ROOT:-$(CDPATH='' cd -- "$ROOT/../.." && pwd)}
cd "$ROOT"
export PYTHONDONTWRITEBYTECODE=1
export PYTHONPATH="$ROOT/src:$CODE_ROOT/dispatch-core${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -B -c 'import json, tempfile; from pathlib import Path; from dispatch_paycom.service import handle
with tempfile.TemporaryDirectory(prefix="dispatch-paycom-health-") as name:
    root = Path(name)
    paths = {key: root / (key + ".sqlite3") for key in ("roster", "timecards", "meals", "identity")}
    print(json.dumps(handle({"action":"health"}, paths=paths), sort_keys=True, separators=(",", ":")))'
